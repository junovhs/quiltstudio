    "svelte-check": "^4.7.8",
    "tsx": "4.20.6",
    "typescript": "5.9",
    "vite": "^8.3.8",
    "wrangler": "^4.162.0"
  },
  "dependencies": {
    "@lucide/svelte": "^1.73.0",
    "@supabase/supabase-js": "^2.119.0"
  }
}
